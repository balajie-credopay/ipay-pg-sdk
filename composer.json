{
    "name": "ipay/paymentgateway",
    "description": "A PHP library for the IPay payment gateway.",
    "type": "library",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "ipay",
        "payment",
        "payment-gateway",
        "php",
        "sdk"
    ],
    "autoload": {
        "psr-4": {
            "IPay\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "authors": [
        {
            "name": "IPay",
            "email": "support@ipay.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}