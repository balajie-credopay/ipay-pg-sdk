
{
    "name": "ipay/paymentgateway",
    "description": "A PHP library for the IPay payment gateway.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ipay",
        "payment",
        "payment-gateway",
        "php",
        "sdk"
    ],
    "autoload": {
        "psr-4": {
            "IPay\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-curl": "*"
    },{
    "name": "ipay/test-project",
    "description": "iPay SDK testing project",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../ipay/ipay-pg-sdk-main",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "ipay/paymentgateway": "^1.0"
    }
}
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "authors": [
        {
            "name": "IPay",
            "email": "support@ipay.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
